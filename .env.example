# LetícIA — configuração de desenvolvimento
#
# Copie para .env e preencha. O .env está no .gitignore e nunca vai para o
# repositório; este arquivo aqui existe só para mostrar o formato.
#
# Sem chave, a LetícIA roda em modo degradado: as 15 perguntas estáticas,
# validação de formato e envio normal, sem comentário nenhum. Isso não é uma
# limitação do ambiente local — é como o produto se comporta quando a API cai,
# e vale rodar assim de vez em quando de propósito.

# A chave é SÓ da LetícIA. Não reaproveite a da LivIA: ela gasta de 3 a 6
# chamadas por atendimento e a LetícIA gasta ~8 por briefing. Dividindo a
# mesma chave, um dia movimentado de uma derruba a outra.
LETICIA_GEMINI_API_KEY=

LETICIA_GEMINI_MODEL=gemini-3.5-flash-lite

# Para onde ela vai quando o principal não responde. Vazio é escolha legítima:
# sem reserva, erro de cota vira modo degradado.
LETICIA_GEMINI_MODEL_RESERVA=

# Chamadas por dia antes de o disjuntor abrir. 0 (ou em branco) é sem teto,
# o padrão por enquanto. Com teto, cada briefing gasta perto de 8 chamadas.
LETICIA_TETO_DIARIO=

# 0 desliga o modelo sem desligar o formulário.
LETICIA_ATIVA=1

# Para onde o briefing vai, um endereço por linha. Em branco vale o
# administrador do site. Localmente nada é enviado de verdade: o servidor
# local grava cada e-mail em local/dados/emails/.
LETICIA_DESTINO=

# Quem dispara. Em branco, o remetente do próprio site.
LETICIA_REMETENTE=

# Onde abre o link de "mandar a logo depois". Em branco, a própria página do
# briefing (localmente, http://localhost:8765/).
LETICIA_LINK_ANEXO_DEPOIS=

# Tudo que estiver preenchido aqui aparece travado na aba Configuração do painel
# local; o que estiver em branco pode ser editado por lá.

# Assina os tokens de retomada. Em produção o WordPress usa o próprio salt;
# aqui, qualquer coisa longa e aleatória serve.
LETICIA_SALT=
